# jit-lab's own settings file: copy to `.env` beside docker-compose.yml (mode 600, gitignored). Never ~/Development/.env.
# Docker Compose passes it into the container; `npm start` reads it too (or the file named by STANDALONE_ENV).
PORT=7570            # allowed range 7570-7579
# JITL_BIND=0.0.0.0  # opt-in only; Docker sets this itself
#
# Real mode (rule 19). With neither issuer below set, the Real button is disabled with a how-to tooltip and Mock
# answers everything. First match wins:
#
# 1. ping-shared's PingFederate (https://127.0.0.1:4732 by default). Recipe for the client: docs/pingfederate-client.md
#   JIT_LAB_PF_CLIENT_SECRET=...             # secret of client jit-lab-agent (write-only, never returned or logged)
#   # JIT_LAB_PF_CLIENT_ID=jit-lab-agent
#   # JIT_LAB_PF_ENGINE=https://127.0.0.1:4732   # another PingFederate runtime. Docker default: https://host.docker.internal:4732
#   # JIT_LAB_PF_SCOPE=agent:invoke:identity
#   # JIT_LAB_PF_CA=/path/to/ca.pem             # optional: pin a CA instead of skipping the certificate check
#
# 2. Your own PingOne tenant (a Worker application's client credentials):
#   PINGONE_ENVIRONMENT_ID=...  PINGONE_WORKER_CLIENT_ID=...  PINGONE_WORKER_CLIENT_SECRET=...

# Host names (besides loopback) the lab answers to, when you put it behind a local proxy.
#LAB_ALLOWED_HOSTS=jit-lab.local.ping-devops.com
